# PostgreSQL directo (REQUERIDO) — cadena de conexión completa
# Formato: postgres://usuario:password@host:puerto/basededatos?sslmode=require
DATABASE_URL=postgres://user:pass@host:5432/mydb

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Orígenes que pueden incrustar widgets, separados por coma.
# En producción: https://shiatsu.ochoesferas.com,https://shiatsu-apse.es
WIDGET_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_SALT=replace-with-a-long-random-value

# Los documentos privados no se activan hasta definir almacenamiento.
PRIVATE_UPLOADS_DIR=

# SMTP (opcional — para envío de emails; ver skill smtp-email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REPLY_TO=
